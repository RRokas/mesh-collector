# --- Droplet (docker compose) -------------------------------------------
# Public hostname Caddy gets a certificate for. No domain? Use <droplet-ip>.sslip.io
DOMAIN=mesh.example.com

# --- App ---------------------------------------------------------------
# Routers use:  https://$DOMAIN/ingest?token=$INGEST_TOKEN
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
INGEST_TOKEN=change-me
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Default: SQLite in the ./data volume. For Postgres:
# DATABASE_URL=postgresql://user:pass@host:25060/db?sslmode=require
# DATABASE_URL=sqlite:////srv/data/mesh.db

# router | raw_be | raw_le   (see README "Byte order")
DECODE_MODE=router

# Alert thresholds
STALE_TAG_MINUTES=30
SILENT_ROUTER_MINUTES=5
DELIVERY_DELAY_WARN_SECONDS=120
TEMP_MIN=-40
TEMP_MAX=85
HUM_MIN=0
HUM_MAX=100
